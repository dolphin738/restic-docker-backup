# ============================================================
# restic-docker-backup（仓库根）
#   shell版本/ = bash 脚本版（v1.x，已完成）
#   web版/     = 容器化 Web 管理版（P1 开发中）
# ============================================================

# ---------- Python / uv ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
dist-ssr/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# venv / 虚拟环境（uv 用 .venv）
.venv/
venv/
env/

# 测试 / lint / 覆盖率缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
htmlcov/
coverage/
.coverage
.coverage.*
coverage.xml
*.cover

# ---------- Node / 前端 ----------
node_modules/
.vite/
.vitest/
*.local
vitest.config.ts.timestamp-*
.eslintcache

# ---------- 配置与密钥（模板 / example 入库，真值不入库）----------
.env
.env.*
!.env.example
# shell 版真实配置（含仓库地址、口令文件路径等机器相关信息）
shell版本/backup.env

# 证书私钥
*.pem
*.key
*.crt
certs/

# ---------- 运行期数据 / 数据库 ----------
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db-journal

data/
cache/
backups/
restic-cache/
restore/
logs/
*.log

# ---------- 编辑器 / 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---------- WorkBuddy ----------
# 会话产物与项目记忆均不入库（2026-10-11 裁决：.workbuddy/ 不入 git、不入 docker）
.workbuddy/

# ---------- dev-scripts 运行时产物（自 web版/dev-scripts/.gitignore 收口）----------
web版/dev-scripts/.dev-data/
web版/dev-scripts/.dev-*.pid

# ---------- 其它 ----------
tmp/
temp/
