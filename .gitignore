# ============================================================
# restic-docker-backup（仓库根）
#   shell版本/ = bash 脚本版（v1.x，已完成）
#   web版/     = 容器化 Web 管理版（P1 开发中）
# ============================================================

# ---------- Python / uv ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
dist-ssr/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# venv / 虚拟环境（uv 用 .venv；dev.sh 在含 Windows 布局 .venv 的仓库里改用 .venv-linux 隔离）
.venv/
.venv-linux/
venv/
env/

# 测试 / lint / 覆盖率缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
htmlcov/
coverage/
.coverage
.coverage.*
coverage.xml
*.cover

# ---------- Node / 前端 ----------
node_modules/
.vite/
.vitest/
*.local
vitest.config.ts.timestamp-*
.eslintcache

# ---------- 配置与密钥（模板 / example 入库，真值不入库）----------
.env
.env.*
!.env.example
# shell 版真实配置（含仓库地址、口令文件路径等机器相关信息）
shell版本/backup.env

# 证书私钥
*.pem
*.key
*.crt
certs/

# ---------- 运行期数据 / 数据库 ----------
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db-journal

/data/
/cache/
/backups/
/restic-cache/
/restore/
/logs/
# docker compose 的运行期卷（compose 文件同级目录）。其中 repos 装的是
# 仓库密码文件＝加密根密钥，绝不能入库；data 装 SQLite/日志；rclone 装 conf（含 OAuth token）。
web版/docker/data/
web版/docker/repos/
web版/docker/rclone/
web版/docker/sources/
web版/docker/restore/
web版/docker/cache/
# 运行期目录改为「仓库根锚定」（前导 /），不再按任意层级匹配——避免吞掉同名源码目录
# （原裸 `restore/` 会忽略 web版/frontend/src/**/restore/，曾致 CI TS2307）。
# 下面两条例外作为纵深防御保留（根锚定后已不会误伤，但显式声明意图）。
!web版/frontend/src/pages/restore/
!web版/frontend/src/components/restore/
*.log

# ---------- 编辑器 / 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---------- WorkBuddy ----------
# 会话产物与项目记忆均不入库（2026-10-11 裁决：.workbuddy/ 不入 git、不入 docker）
.workbuddy/
# codebase-memory MCP 的代码索引缓存（同口径：会话产物不入库）
.codebase-memory/

# ---------- dev-scripts 运行时产物（自 web版/dev-scripts/.gitignore 收口）----------
web版/dev-scripts/.dev-data/

# ---------- 真机 E2E 脚本与产物 ----------
# playwright-cli 的 daemon session 跨命令不保活，改用 Node 脚本常驻持有浏览器；
# 脚本内含本机绝对路径（DevEco node 前缀），对他人不可复用，故不入库。
# 方案与踩坑已记入 .workbuddy/memory/（同样不入库），需要时按记录重建。
.e2e/
web版/dev-scripts/.dev-*.pid

# ---------- 其它 ----------
tmp/
temp/
# 受限沙箱下跑 pytest 时临时重定向的目录：pytest 的 tmp_path 夹具会在其中建
# pytest-of-<user>，其 ACL 可能被锁住而无法回收——不入库即可，不必清理
web版/backend/.tmp-run/
web版/backend/.pytest-tmp/
web版/backend/.pytest_cache/
# pytest 在 cwd 落下的临时产物（tmp_path 创建失败或被 ACL 锁死时残留）
web版/backend/pytest-of-*/
# 从 web版/ 根目录跑 pytest 时 tmp_path 会落在这里（同上，不入库）
web版/pytest-of-*/
web版/backend/rclone-meta-test-*/
web版/backend/.pytemp*/
web版/backend/.tmp-split/
.ci-image-tags
# P4 HomeIcons 目视预览页（一次性验证产物，与 .e2e/ 同口径：本机保留、不入库）
web版/frontend/icon-preview.html
