# 统一 LF：避免 Windows 检出导致 shell 脚本 ^M
* text=auto eol=lf

# 必须 LF（容器内执行）
*.sh text eol=lf
entrypoint text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Windows 脚本保留 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
