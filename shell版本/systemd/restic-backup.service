[Unit]
Description=restic backup (docker)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# 修改为实际部署路径
WorkingDirectory=/opt/restic-docker-backup
ExecStart=/opt/restic-docker-backup/restic-backup.sh
# 备份任务可容忍较长时间；按数据量调整
TimeoutStartSec=6h
# 失败自动重试 2 次，间隔 5 分钟
Restart=on-failure
RestartSec=5min
Nice=10
IOSchedulingClass=idle
# 日志进 journald：journalctl -u restic-backup.service
StandardOutput=journal
StandardError=journal
