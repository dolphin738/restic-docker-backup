# =============================================================================
#  restic-docker 备份配置（样例）
# =============================================================================
#  使用方法：
#    cp backup.env.example backup.env
#    chmod 600 backup.env        # 本文件包含仓库密码等敏感信息，必须收紧权限
#    vim backup.env              # 按下面的标注逐项修改
#
#  格式约定：
#    - 纯 KEY=VALUE 格式，由主脚本 source 后导出，等号两侧不要有空格
#    - 值中含空格/特殊字符时必须加英文双引号
#    - 多行列表项（如备份源）写在英文双引号内，每行一个
#
#  配置项分级标注（每个配置项的注释首行都有）：
#    【必改】   —— 必须按你的实际环境修改，不改会备份失败或备到错误位置
#    【按需】   —— 默认值可以跑通，但多数场景建议按需调整
#    【默认】   —— 保持默认值即可，除非你明确知道自己在改什么
# =============================================================================

## ══ 1. 仓库后端（核心配置，本节全部【必改】）══════════════════════════════

# 【必改】restic 备份仓库地址：数据最终存放的位置。
#   取值格式（任选一种，前缀决定后端类型）：
#     S3 及兼容（AWS/R2/OSS/MinIO）: s3:https://<endpoint>/<桶名>/<路径>
#       例: s3:https://s3.us-east-1.amazonaws.com/my-bucket/vps1
#       例: s3:https://<accountid>.r2.cloudflarestorage.com/my-bucket
#       例: s3:http://10.0.0.5:9000/my-bucket          （MinIO 自建，注意是 http）
#     Backblaze B2:            b2:<桶名>:<路径>
#     SFTP（另一台服务器）:    sftp:<用户>@<主机>:<路径>
#     rclone（任意云盘）:      rclone:<远程名>:<路径>
#     本地磁盘/挂载盘:         /mnt/backup/restic-repo   （无前缀，直接写路径）
#   注意事项：
#     - 异地备份优先选跨供应商的对象存储，不要放同一台 VPS 的另一块盘
#     - 仓库路径建议带主机名（如 /vps1），一台服务器对应一个子路径，便于按主机分组管理
#     - 本地路径仓库（无前缀）会被脚本自动以【可写】方式挂载进容器，
#       init/备份/校验都直接落在宿主机该目录——无需手工另加挂载
#   不修改的后果：样例值指向不存在的桶，首次备份时认证/写库直接失败，脚本报错退出
RESTIC_REPOSITORY="s3:https://s3.us-east-1.amazonaws.com/my-bucket/vps1"

# 【按需】需要透传给 restic 容器的环境变量名清单，空格分隔。
#   用途：脚本只会把这里列出的变量名传进容器，避免宿主机其他环境变量泄漏进备份进程；
#         未设置的变量会被自动跳过并在日志中记 WARN，不会报错。
#   取值格式：环境变量【名】的列表（不是值！），按所选后端增删：
#     AWS S3 / R2 / OSS(S3兼容):  AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION
#     Backblaze B2:               B2_ACCOUNT_ID B2_ACCOUNT_KEY
#     MinIO 自建:                 AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
#     SFTP / rclone / 本地路径:   无需额外变量，保持现状即可
#   注意事项：这些变量本身的值写在系统的环境变量里（如 /etc/environment 或 systemd 单元的 Environment=）。
#   不修改的后果：换后端后忘了把对应变量名加进来，容器内拿不到密钥，备份报 "access denied" 类错误
RESTIC_ENV_VARS="RESTIC_REPOSITORY RESTIC_PASSWORD_FILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION"

# 【默认】仓库密码在容器内的读取路径，脚本内部约定，一般不需要动。
#   取值格式：容器内绝对路径；脚本会把 RESTIC_PASSWORD_FILE_HOST 只读挂载到这里。
#   注意事项：若改此值，必须与 RESTIC_PASSWORD_FILE_HOST 保持「宿主机路径:容器内路径」的对应关系。
RESTIC_PASSWORD_FILE="/run/secrets/restic_pass"

# 【必改】仓库密码文件在宿主机上的路径。
#   取值格式：宿主机绝对路径，指向一个只含密码文本的文件。
#   建议创建方式（随机生成 + 权限 600）：
#     sudo sh -c 'umask 077; mkdir -p /etc/restic; head -c 32 /dev/urandom | base64 > /etc/restic/pass'
#   注意事项：
#     - 密码内容务必另存到密码管理器/离线一份——密码丢失 = 仓库数据永久无法解密
#     - 不存在的文件路径会导致脚本启动即失败（属预期保护，防止带错配置跑空）
#   不修改的后果：/etc/restic/pass 不存在或不可读，脚本报「密码文件不可读」退出
RESTIC_PASSWORD_FILE_HOST="/etc/restic/pass"

# 【按需】仓库密码明文（不推荐，仅测试环境用；设置后优先生效，保持注释即禁用）。
#   用途：不想建密码文件时直接写明文；因会出现在本文件和进程环境中，生产环境不要用。
#   注意事项：与密码文件同时存在时，明文 RESTIC_PASSWORD 优先，容易造成
#             「改了文件密码却不生效」的困惑，二选一即可。
#   不修改的后果：保持注释状态无任何影响
# RESTIC_PASSWORD="change-me"

## ══ 2. Docker 运行参数（大部分【默认】即可）═══════════════════════════════

# 【按需】restic 镜像及版本号。
#   用途：固定版本保证备份行为可复现、可回退；升级 restic 时只改这里。
#   取值格式：Docker 镜像名:tag。请勿使用 latest——行为不可复现，出问题难定位。
#   注意事项：升级前先在测试环境验证仓库兼容性；--compression 压缩参数需 restic 0.17+。
#   不修改的后果：0.19.1 为当前最新稳定版，保持默认即可
RESTIC_IMAGE="restic/restic:0.19.1"

# 【默认】本地没有该镜像时是否自动 docker pull（true/false）。
#   注意事项：离线环境（访问不了 Docker Hub）应改为 false，并提前手动导入镜像。
#   不修改的后果：离线环境首次运行会卡在拉取镜像直到失败
AUTO_PULL="true"

# 【默认】容器内运行用户（UID:GID），留空使用镜像默认 root。
#   用途：以非 root 身份运行 restic 进程（安全加固）；恢复出的文件属主为该 UID。
#   取值格式："1000:1000" 或留空 ""。
#   注意事项：改为非 root 后，需保证该 UID 对备份源可读、对缓存目录可写。
#   不修改的后果：保持 root 运行，功能不受影响，仅安全性稍弱
DOCKER_USER=""

# 【按需】restic 缓存目录（宿主机侧），务必持久化。
#   用途：restic 在本地缓存仓库索引，避免每次备份全量拉取，大仓库可快数倍。
#   取值格式：宿主机绝对路径，脚本会自动创建。
#   注意事项：确保所在分区有足够空间（通常几百 MB 到几 GB）；清空该目录不丢数据，只是变慢。
#   不修改的后果：改到不可写路径会导致备份失败
CACHE_DIR="/var/cache/restic"

# 【默认】缓存目录在容器内的挂载点，与 CACHE_DIR 配套的脚本内部约定，无需修改。
#   取值格式：容器内绝对路径
RESTIC_CACHE_DIR="/cache"

# 【默认】容器时区，影响日志和通知里的时间戳显示。
#   取值格式：IANA 时区名，如 Asia/Shanghai、UTC。
#   不修改的后果：日志显示 UTC 时间，与本地差 8 小时，排查问题时容易误判时间线
TZ="Asia/Shanghai"

## ══ 3. 备份源（【必改】）═══════════════════════════════════════════════════

# 【必改】要备份的文件/目录清单，每行一个，写在英文双引号内。
#   取值格式：宿主机绝对路径，每行一条；支持文件和目录；不存在的路径会被跳过并记 WARN。
#   注意事项：
#     - 每个路径按原路径只读挂载进容器（容器内路径 = 宿主机路径），恢复时可按原路径直接还原
#     - 不支持「宿主机:容器内路径」映射写法：路径含英文冒号会被跳过并警告
#     - 不要备份 /proc /sys /dev 等虚拟文件系统
#     - 不要挂载 / /usr /bin /lib /sbin /boot 等系统目录——会遮盖容器镜像内 restic 自身，
#       且系统恢复应使用服务商快照，不走文件备份
#     - 数据库不要靠拷数据文件备份，请启用第 8 节的 dump 功能
#     - 建议至少覆盖：配置（/etc）、网站/应用数据、数据库 dump 目录
#   不修改的后果：样例路径与实际不符时，要么全被跳过（备份了个寂寞），要么漏掉关键数据，
#                 出事时才发现「备份里没有它」——这是备份失效最常见的形态
BACKUP_SOURCES="
/etc
/home
/var/www
/var/backups/dump
"

## ══ 4. 排除规则（【按需】）═════════════════════════════════════════════════

# 【按需】排除规则清单，每行一条，直接作为 restic 的 --exclude 参数。
#   用途：从备份中剔除无价值/体积大的内容，省存储、省流量、加快备份。
#   取值格式：restic 通配模式（支持 *、**、?），每行一条；# 开头视为注释。
#   常用建议：
#     **/.cache/**              —— 各种缓存目录
#     **/node_modules/**        —— 前端依赖，可随时重装
#     **/*.tmp                  —— 临时文件
#     /var/backups/dump/restic* —— 防止把备份仓库自身也备份进去（套娃）
#   注意事项：排除前确认该内容确实可再生成；拿不准的先保留。
#   不修改的后果：保持默认无碍；不排除缓存类目录则仓库体积和备份时长明显变大
EXCLUDE_PATTERNS="
**/.cache/**
**/node_modules/**
**/*.tmp
/var/backups/dump/restic*
"

## ══ 5. 备份行为（【默认】为主）═════════════════════════════════════════════

# 【按需】备份主机标识（快照归属主机名）。
#   用途：容器默认每次运行获得随机主机名，会让按主机分组的保留策略失效
#         （每个快照自成分组 → forget 永远无可删除项），因此脚本强制传 --host。
#   取值格式：留空 = 自动取宿主机 hostname（推荐）；也可自定标识如 vps1。
#   多台服务器共用一个仓库时，此值用于区分各机快照，务必各不相同。
#   不修改的后果：留空即自动取宿主机名，通常无需设置
RESTIC_HOST=""

# 【默认】快照标签，打在每次备份上，便于后续 forget/查询按标签过滤。
#   取值格式：多个标签用英文逗号分隔（restic 会给快照同时打上所有标签），单个标签内不含空格；
#   中英文均可（UTF-8 字符串）。默认值 = 英文+中文双标签，两种写法都能检索到同一快照。
#   检索示例：./restic.sh snapshots --tag scheduled 与 ./restic.sh snapshots --tag 例行备份 等效
#   注意事项：--tag 命令行参数同样支持逗号多标签，如 --tag "pre-upgrade,升级前"
BACKUP_TAG="scheduled,例行备份"

# 【按需】追加给 restic backup 的额外参数，空格分隔。
#   默认值含义：
#     --one-file-system    不跨文件系统边界，防止把 /proc、Docker 卷等挂载点扫进去（强烈建议保留）
#     --compression auto   0.17+ 的数据压缩，auto 表示按数据类型自动决定是否压缩，省存储和流量
#   取值格式：restic backup 的合法参数；不需要压缩可删掉 --compression auto（老仓库兼容性更稳）。
#   注意事项：修改后先用 --dry-run 演练一次确认参数合法。
#   不修改的后果：保持默认即可，是安全且推荐的组合
EXTRA_BACKUP_ARGS="--one-file-system --compression auto"

# 【按需】演练开关（true/false）：true 时只模拟备份、不实际写入，用于验证配置和路径。
#   注意事项：演练模式下 forget/prune、check、本地 dump 清理均不执行。
#   不修改的后果：false 为正常备份；生产日常运行必须保持 false，
#                 长期忘在 true 会造成「以为在备份其实什么都没写」的事故
DRY_RUN="false"

## ══ 6. 保留策略（【按需】，决定历史版本保留多久）══════════════════════════

# 【默认】是否自动执行 forget --prune 清理过期快照（true/false）。
#   注意事项：false 时仓库只增不减，存储费用持续上涨。
#   不修改的后果：true + 下述档位 = 自动清理，一般无需改动
FORGET_ENABLED="true"

# 【按需】保留策略只作用于带此标签的快照；留空 = 所有快照都参与策略。
#   典型场景：例行任务打 scheduled+例行备份 双标签，升级前手动跑
#   ./restic-backup.sh --tag "pre-upgrade,升级前"，并在这里设 FORGET_TAG="scheduled"——
#   则保留策略只清理例行快照，升级前快照永不过期
#   （想清理旧的手动快照时手动执行: ./restic.sh forget --tag pre-upgrade --keep-last 5 --prune）。
#   注意事项：双标签下填英文名或中文名均可（匹配"含该标签"的快照）；必须与例行标签之一一致才有意义。
#   不修改的后果：留空时手动备份的快照也会被保留策略照常清理
FORGET_TAG=""

# 【按需】各时间档位保留的快照数量，0 表示该档位不启用。每日备份场景下：
#   KEEP_DAILY=7    保留最近 7 天各 1 份
#   KEEP_WEEKLY=4   保留最近 4 周各 1 份
#   KEEP_MONTHLY=6  保留最近 6 个月各 1 份
#   KEEP_YEARLY=1   保留最近 1 年 1 份
#   取值格式：非负整数。
#   注意事项：
#     - forget 是「每档位独立保留」，实际快照总数 ≈ 各档位之和
#     - prune 会物理删除过期数据块，把 KEEP_* 改小 = 永久丢历史版本！
#       改动前务必先用 ./restic.sh forget --dry-run <同样参数> 预览会删掉哪些
#   不修改的后果：默认策略（7天/4周/6月/1年）适合大多数场景，保持即可
KEEP_LAST="0"
KEEP_DAILY="7"
KEEP_WEEKLY="4"
KEEP_MONTHLY="6"
KEEP_YEARLY="1"

# 【默认】forget 的快照分组维度。
#   用途：把「同主机+同备份源路径」的快照归为一组分别应用保留策略，
#         避免多主机共用一个仓库时互相挤掉对方的保留名额。
#   取值格式：host,paths / host / tags / ""（全局一组）；单机保持 host,paths 即可
FORGET_GROUP_BY="host,paths"

## ══ 7. 仓库校验（【默认】即可）═════════════════════════════════════════════

# 【默认】是否在每次备份后做仓库完整性校验（true/false）。
#   不修改的后果：false 则从不校验，磁盘静默损坏（bit-rot）要等到恢复时才被发现，不建议关闭
CHECK_ENABLED="true"

# 【按需】抽样校验比例：每次只读取仓库中这么多比例的数据包做完整性验证。
#   取值格式：百分比（10%）、分数（1/3）或字节数（100M）；比例越大越彻底也越慢。
#   注意事项：大仓库建议 10%~25%；彻底的全量校验交给下面的每月任务。
#   不修改的后果：10% 抽样对中小仓库足够，保持即可
CHECK_SUBSET="10%"

# 【按需】每月这一天执行一次全量校验（读取仓库全部数据），"0" 关闭。
#   用途：全量校验能发现所有静默损坏，但很慢、IO 高，放月度低峰执行。
#   取值格式："01"~"31" 中的一天，或 "0" 关闭。
#   注意事项：数据量大的仓库建议安排在业务最空闲的日子。
#   不修改的后果：每月 1 号跑一次全量校验，一般无需改动
CHECK_FULL_DAY_OF_MONTH="01"

# 【默认】备份异常退出后是否自动 restic unlock 清理残留锁（true/false）。
#   用途：进程被杀/断电后仓库可能留下锁文件，导致下次备份报 "repository is already locked"。
#   注意事项：仅在确认无其他进程并发操作仓库的环境开启（本脚本有 flock 防重入，可放心开）。
#   不修改的后果：保持 true 可自动自愈，无需人工介入
AUTO_UNLOCK="true"

## ══ 8. 数据库 dump（【按需】；一旦启用数据库，本节标 * 的项【必改】）═══════

# 【按需】是否启用数据库逻辑备份（true/false）。
#   用途：先把数据库导出为文件落到 DB_DUMP_DIR，再由 restic 一并备份。
#   注意事项：Docker 版 restic 镜像内没有 pg_dump/mysqldump，所以必须在宿主机侧先导出。
#   不修改的后果：false 则只备份文件系统；若数据库数据文件又不在备份源里，
#                 数据库将完全无备份——有数据库务必改为 true
DB_ENABLED="false"

# 【按需】数据库类型（DB_ENABLED=true 时必改）。
#   取值格式：postgres / mysql / none。
#   不修改的后果：none 等于没启用数据库备份
DB_TYPE="none"

# 【按需】数据库 dump 文件的落盘目录，该目录必须同时出现在第 3 节 BACKUP_SOURCES 里。
#   取值格式：宿主机绝对路径，不存在时脚本会自动创建。
#   注意事项：确认该目录被备份源覆盖，否则 dump 了也不会进仓库，白导出。
#   不修改的后果：默认 /var/backups/dump 已在样例备份源中，配套使用即可
DB_DUMP_DIR="/var/backups/dump"

# 【默认】本地 dump 文件保留天数（仓库里另有历史版本，这里只管本地磁盘占用）。
#   取值格式：正整数。
#   注意事项：脚本只删除该目录下匹配 *.dump / *.sql 的过期文件，不会碰其他文件。
#   不修改的后果：3 天对绝大多数场景足够
DB_KEEP_DAYS="3"

# ── PostgreSQL（DB_TYPE=postgres 时按需修改）───────────────────────────────

# 【按需】pg_dump 执行方式：
#   host   —— 宿主机直接执行 pg_dump（需宿主机装有 postgresql-client）
#   docker —— 通过 docker exec 在 PostgreSQL 容器内执行（需填 PG_CONTAINER）
#   取值格式：host / docker
PG_DUMP_METHOD="host"

# 【按需】PostgreSQL 容器名（仅 PG_DUMP_METHOD=docker 时必填）。
#   查询方式：docker ps --format '{{.Names}}'。
#   不修改的后果：容器名不存在时 dump 失败、脚本报错退出（属预期保护）
PG_CONTAINER="postgres"

# 【必改*】数据库连接参数（启用 postgres 备份时按实际环境修改）：
#   PG_USER      连接用户，需有目标库读权限
#   PG_DATABASE  要导出的库名；多库需求可改用 pg_dumpall 或另加配置组
#   PG_HOST      数据库地址（仅 host 模式使用）
#   PG_PORT      数据库端口（仅 host 模式使用）
#   注意事项：docker 模式下 PG_HOST/PG_PORT 不生效（走容器内部网络）。
#   不修改的后果：连接失败或库名不存在，dump 输出为空，脚本检测到空文件报错退出
PG_USER="app"
PG_DATABASE="appdb"
PG_HOST="127.0.0.1"
PG_PORT="5432"

# 【按需】连接密码（host 模式用；更推荐用 ~/.pgpass 文件，避免密码写进本文件）。
#   docker 模式下会通过 docker exec -e 传给容器内的 pg_dump。
#   不修改的后果：留空且无 ~/.pgpass 时，pg_dump 交互式询问密码，cron/systemd 下会卡住失败
# PGPASSWORD="..."

# ── MySQL / MariaDB（DB_TYPE=mysql 时按需修改）─────────────────────────────

# 【按需】mysqldump 执行方式：host（宿主机执行）/ docker（容器内执行）。
MYSQL_DUMP_METHOD="host"

# 【按需】MySQL 容器名（仅 MYSQL_DUMP_METHOD=docker 时必填）。
#   查询方式：docker ps --format '{{.Names}}'；1Panel 创建的容器名形如 1Panel-mysql-xxxx，
#   在面板「容器」列表或应用详情里查看后填实际名称。
MYSQL_CONTAINER="mysql"

# 【按需】MySQL root 密码（docker 模式专用，优先级高于 MYSQL_DEFAULTS_FILE）。
#   典型场景：1Panel 等面板创建的 MySQL 容器自带 root 密码（面板「应用详情/数据库」里可见），
#   把它填到这里即可，免去在容器内准备凭据文件的麻烦。
#   注意事项：值会写进本文件，务必保持 chmod 600；留空则回退用 MYSQL_DEFAULTS_FILE。
# MYSQL_ROOT_PASSWORD="..."

# 【必改*】要导出的库名（启用 mysql 备份时按实际环境修改）。
#   不修改的后果：库不存在时 dump 失败或导出为空，脚本报错退出
MYSQL_DATABASE="appdb"

# 【按需】MySQL 凭据文件路径（my.cnf 格式，含 [client] 段的 user/password，权限必须 600）。
#   取值格式：绝对路径。
#   注意事项：host 模式下是宿主机路径；docker 模式下是容器内路径，需自行保证容器内可读。
#   不修改的后果：文件不存在时 mysqldump 用默认凭据连接，大概率认证失败
MYSQL_DEFAULTS_FILE="/etc/mysql/backup.cnf"

## ══ 9. 挂载与 SELinux（【按需】）═══════════════════════════════════════════

# 【默认】SELinux 挂载标签策略（RHEL/CentOS/Rocky 系必须关注，Debian/Ubuntu 可忽略）。
#   取值格式：
#     auto —— 自动检测：系统启用 SELinux 时自动给只读挂载加 ,z 标签（推荐保持）
#     z    —— 强制加共享标签（多个容器可共享读取）
#     Z    —— 强制加私有标签（仅当前容器可读，更严格）
#     none —— 不加标签（SELinux 启用时会 Permission denied！）
#   不修改的后果：auto 已能自动适配；手动改 none 且系统开了 SELinux，
#                 容器读不了备份源，备份直接失败
SELINUX_LABEL="auto"

# 【按需】额外挂载清单，每行格式：宿主机路径[:容器内路径[:选项]]（省略时默认同名挂载、只读）。
#   用途：给 restic 后端提供宿主机上的辅助文件，典型场景：
#     SFTP 后端   —— 挂载 SSH 私钥与 known_hosts：/root/.ssh:/root/.ssh:ro
#     rclone 后端 —— 挂载 rclone 配置：/root/.config/rclone:/root/.config/rclone:ro
#   注意事项：
#     - 每行 # 开头视为注释；路径必须真实存在，不存在的会被跳过并记 WARN
#     - 恢复目标目录不用在这里配，restic.sh 会自动挂载
#   不修改的后果：用 SFTP/rclone 后端而不挂对应配置，容器内找不到密钥/配置，连接失败；
#                 S3/B2/本地后端无需任何额外挂载，保持注释状态即可
EXTRA_MOUNTS="
# /root/.config/rclone:/root/.config/rclone:ro
# /root/.ssh:/root/.ssh:ro
"

## ══ 10. 告警通知（【按需】；强烈建议至少配一种）═══════════════════════════

# 【按需】healthchecks.io / Cronitor 风格的看门狗地址。
#   用途：脚本开始时 ping /start；成功 ping 根地址（附结果摘要）；失败 ping /fail（附错误）。
#         超过预期时间没收到心跳，平台会主动告警——这是唯一能发现「备份压根没跑」的手段。
#   取值格式：完整 URL，如 https://hc-ping.com/<你的uuid>；留空禁用。
#   不修改的后果：留空则静默失败——cron/systemd 挂了、机器宕机都不会有任何提醒，
#                 直到需要恢复时才发现备份早已停摆
HEALTHCHECK_URL=""

# 【按需】自定义通知命令，%MSG% 会被替换成结果消息（成功与失败都会调用）。
#   用途：对接飞书/钉钉/企业微信机器人或任意 shell 命令；成功是否也通知由 NOTIFY_ON_SUCCESS
#         控制（脚本内置默认 true，可在 backup.env 里加一行覆盖）。
#   取值格式：一条完整 shell 命令（可用管道）；消息进 JSON 时注意引号转义。
#   示例（飞书机器人）：
#     curl -sS -X POST -H 'Content-Type: application/json' \
#       -d '{"msg_type":"text","content":{"text":"%MSG%"}}' \
#       https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
#   不修改的后果：留空则只依赖 HEALTHCHECK_URL；两者都空 = 完全无告警，不建议
NOTIFY_CMD=""

## ══ 11. 日志与锁（【默认】即可）════════════════════════════════════════════

# 【按需】supervisor-timer.sh（1Panel 进程守护定时方式）专用：调度日志落盘开关
#   默认关闭：调度日志（补跑判断/触发/重试/睡眠）仅 stdout，由 Supervisor 接管
#   设为 true 后双写到 TIMER_LOG_FILE 指定路径；1Panel 进程守护的环境变量优先于本配置
#   （systemd timer / 1Panel 计划任务方式不读取这两项，无需设置）
TIMER_LOG_ENABLED="false"
TIMER_LOG_FILE="/var/log/restic-timer.log"

# 【默认】脚本运行日志文件（追加写入；systemd 部署时 journald 里也有一份）。
#   取值格式：宿主机绝对路径，父目录不存在时自动创建。
#   注意事项：日志含仓库地址与备份源路径，注意该文件的权限管理。
#   不修改的后果：写到不可写路径时日志静默丢失（不影响备份本体）
LOG_FILE="/var/log/restic-backup.log"

# 【按需】恢复向导（menu.sh 恢复功能）的默认目标目录。
#   取值格式：宿主机绝对路径，菜单提供时会作为默认值展示，可直接回车采用。
RESTORE_TARGET="/restore"

# 【默认】并发锁文件：防止上一轮备份没跑完又启动新一轮（配合 flock）。
#   取值格式：宿主机绝对路径。
#   不修改的后果：一般无需改动；锁被占用时报「已有备份进程在运行」退出，属正常保护
LOCK_FILE="/var/lock/restic-backup.lock"

## ══ 12. 定时方式参数（supervisor-timer / systemd timer 安装时读取）════════

# 【按需】触发时间（24 小时制；两种定时方式共用，务必保持一致语义）
#   supervisor-timer: 读 RUN_HOUR/RUN_MIN
#   systemd timer   : menu.sh 安装时把 SCHEDULE 写入 OnCalendar
RUN_HOUR="3"
RUN_MIN="30"
SCHEDULE="*-*-* 03:30:00"

# 【按需】失败重试次数与重试间隔（秒）
#   supervisor-timer: 直接读取
#   systemd 版      : menu.sh 安装时把 RETRY_INTERVAL 写入 RestartSec
RETRY_MAX="2"
RETRY_INTERVAL="300"

# 【按需】到点后随机延迟上限（秒），0 = 关闭
#   supervisor-timer: 直接读取
#   systemd 版      : menu.sh 安装时写入 RandomizedDelaySec
RANDOM_DELAY_SEC="900"

# 【按需】成功标记目录（supervisor-timer 的补跑判断使用）
STATE_DIR="/var/lib/restic-backup"

# 【按需】systemd 单次备份超时（menu.sh 安装 timer 时写入 TimeoutStartSec）
#   取值格式：systemd 时长格式，如 6h / 2h / 90min
TIMEOUT_START_SEC="6h"

## ══ 13. 多策略备份（【按需】；不设置则使用上面的单一策略，完全兼容）════════

# 【按需】多策略模式：备份源/标签/保留档位不同的目录各自独立备份与清理。
#   启用方式：把策略名（仅字母数字下划线）填入 BACKUP_POLICIES，并为每个策略定义
#   POLICY_<策略名>_* 变量（见下方注释掉的示例）。设置后：
#     - 全局 BACKUP_SOURCES / KEEP_* / FORGET_TAG 不再生效
#     - BACKUP_TAG 仍作为各策略 TAG 缺省时的回退默认值
#     - 所有策略共用 RESTIC_HOST 与同一个仓库；每策略独立执行 backup 与 forget
#       （按自身标签），末尾统一 restic prune
#   不修改的后果：留空 = 单策略模式，行为与旧版完全一致
BACKUP_POLICIES=""

# ── 策略定义模板（启用多策略后取消注释并按需修改）─────────────────────────
# 【必改*】每个策略的标签与备份源（启用多策略时按实际环境修改）
# POLICY_etc_TAG="scheduled,例行备份"
# POLICY_etc_SOURCES="
# /etc
# "
# POLICY_etc_KEEP_DAILY="7"
# POLICY_etc_KEEP_WEEKLY="4"
# POLICY_etc_KEEP_MONTHLY="6"
# POLICY_etc_KEEP_YEARLY="1"
#
# POLICY_panel_TAG="panel,面板快照"
# POLICY_panel_SOURCES="
# /home/dolphin738/1panel/backup/system_snapshot
# "
# POLICY_panel_KEEP_LAST="5"
#
# 注意事项：
#   - 策略级 EXCLUDE 可用 POLICY_<名>_EXCLUDE_PATTERNS 追加（格式同全局排除），
#     全局 EXCLUDE_PATTERNS 对所有策略同样生效
#   - 多策略模式下 BACKUP_TAG / --tag / FORGET_TAG 不生效
#   - 保留策略 forget 按策略标签分别执行，末尾统一 restic prune 一次

## ══ 14. 自调度频率（【按需】；supervisor-timer / systemd timer / 计划任务通用）══

# 【按需】每策略备份间隔（分钟）。任一策略设置后，restic-backup.sh 进入自调度模式：
#   每次被调度器唤醒时逐策略判定到期（距上次运行 ≥ 间隔）才备份，未到期秒级跳过。
#   效果：调度器只需以最高巡检频率触发（systemd 单元 OnCalendar=hourly /
#   1Panel 计划任务每小时 / supervisor-timer 自动切换间隔巡检模式），
#   各策略的真实备份频率由这里的数值表达——一个调度单元承载全部策略。
#   取值格式：正整数分钟；未设置 = 该策略跟随每日到点/每日任务（1440）。
#   注意事项：建议 ≥ 15（docker 启动开销）；状态记录在 STATE_DIR/last-<策略名>。
# POLICY_system_INTERVAL_MIN="1440"

# 【按需】forget + prune 的清理间隔（分钟），默认 1440（每天一次）。
#   prune 是全仓库重扫，与备份频率解耦、独立判到期，避免高频策略拖累清理。
#   自调度模式下由 restic-backup.sh 内部判定；其他模式随每日任务执行。
PRUNE_INTERVAL_MIN="1440"
